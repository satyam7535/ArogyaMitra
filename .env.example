# ==============================================================================
# ArogyaMitra — Root Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ── Backend Configuration ─────────────────────────────────────────────────────
PORT=5000
DB_URL=mongodb://localhost:27017/arogyamitra
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRY=1d
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary (Medical report & prescription asset storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── ML Microservice Configuration ─────────────────────────────────────────────
ML_PORT=8000
ML_API_URL=http://localhost:8000

# ── Graph & LLM Orchestration Configuration ───────────────────────────────────
GRAPH_PORT=8001
GRAPH_API_URL=http://localhost:8001

# LLM Provider: Google Gemini via OpenAI-Compatible Endpoint
LLM_API_KEY=your_google_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-1.5-flash
